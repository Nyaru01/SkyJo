import React, { useState, useRef, useEffect } from 'react';
import { Trophy, Target, Sparkles, Zap } from 'lucide-react';

const App = () => {
  const [isPressed, setIsPressed] = useState(false);
  const [mousePos, setMousePos] = useState({ x: 0, y: 0 });
  const [isBooting, setIsBooting] = useState(true);
  const containerRef = useRef(null);

  useEffect(() => {
    const timer = setTimeout(() => setIsBooting(false), 800);
    return () => clearInterval(timer);
  }, []);

  const handleInteraction = (e) => {
    if (!containerRef.current) return;
    const rect = containerRef.current.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    
    const x = (clientX - rect.left) / rect.width - 0.5;
    const y = (clientY - rect.top) / rect.height - 0.5;
    setMousePos({ x, y });
  };

  return (
    <div className="min-h-screen bg-[#050510] flex items-center justify-center p-4 font-sans antialiased overflow-hidden transition-colors duration-1000">
      
      {/* Ambiance de fond profonde */}
      <div className="fixed inset-0 bg-[#0a0a1a] pointer-events-none" />
      <div className="fixed inset-0 bg-[radial-gradient(circle_at_50%_50%,#242464_0%,transparent_100%)] opacity-60 pointer-events-none" />

      {/* PLATEAU DE JEU (FORMAT 21:9) */}
      <div 
        ref={containerRef}
        onMouseMove={handleInteraction}
        onTouchMove={handleInteraction}
        onMouseLeave={() => setMousePos({ x: 0, y: 0 })}
        className={`relative w-full max-w-7xl aspect-[21/9] rounded-[48px] bg-[#0c0c1e] overflow-hidden border border-white/5 shadow-[0_0_150px_rgba(0,0,0,0.9)] transition-all duration-1000 ease-out 
          ${isPressed ? 'scale-[0.99] brightness-110' : 'scale-100'}
          ${isBooting ? 'opacity-0 scale-95 blur-3xl' : 'opacity-100 scale-100 blur-0'}`}
        style={{
          transform: `perspective(2000px) rotateX(${mousePos.y * 5}deg) rotateY(${mousePos.x * 5}deg)`,
          touchAction: 'none'
        }}
        onMouseDown={() => setIsPressed(true)}
        onMouseUp={() => setIsPressed(false)}
        onTouchStart={() => setIsPressed(true)}
        onTouchEnd={() => setIsPressed(false)}
      >
        
        {/* FOND VIVANT MULTI-COUCHES */}
        <div className="absolute inset-0 pointer-events-none overflow-hidden">
          {/* Orbes de plasma en mouvement */}
          <div className="absolute top-[-20%] left-[-10%] w-[60%] h-[80%] bg-[#1c2739] blur-[120px] rounded-full animate-[pulse_10s_ease-in-out_infinite] opacity-40" />
          <div className="absolute bottom-[-20%] right-[-10%] w-[60%] h-[80%] bg-[#242464] blur-[120px] rounded-full animate-[pulse_8s_ease-in-out_infinite_reverse] opacity-40" />
          
          {/* Projecteur interactif renforcé */}
          <div 
            className="absolute inset-0 transition-opacity duration-1000 opacity-70"
            style={{
              background: `radial-gradient(800px circle at ${50 + mousePos.x * 80}% ${50 + mousePos.y * 80}%, rgba(56,189,248,0.1), transparent)`
            }}
          />

          {/* Particules de lumière (Poussière d'étoiles) */}
          {[...Array(20)].map((_, i) => (
            <div 
              key={i}
              className="absolute rounded-full bg-blue-200/40 blur-[1px] animate-[float_15s_linear_infinite]"
              style={{
                width: `${Math.random() * 3 + 1}px`,
                height: `${Math.random() * 3 + 1}px`,
                top: `${Math.random() * 100}%`,
                left: `${Math.random() * 100}%`,
                animationDelay: `${i * -1.5}s`,
                animationDuration: `${10 + Math.random() * 10}s`
              }}
            />
          ))}

          {/* Texture grainée dynamique */}
          <div className="absolute inset-0 opacity-[0.2] bg-[url('https://grainy-gradients.vercel.app/noise.svg')] mix-blend-overlay" />
          
          {/* Grille de perspective très subtile */}
          <div className="absolute inset-0 opacity-[0.05] bg-[linear-gradient(to_right,#818cf8_1px,transparent_1px),linear-gradient(to_bottom,#818cf8_1px,transparent_1px)] bg-[size:100px_100px] [transform:perspective(1000px)_rotateX(60deg)_translateY(200px)]" />
        </div>

        {/* LISERÉ LUMINEUX DYNAMIQUE (Border Flow) */}
        <div className="absolute inset-0 pointer-events-none">
          <div className="absolute inset-4 rounded-[36px] border border-white/5" />
          <div className="absolute inset-4 rounded-[36px] border border-transparent [mask-image:linear-gradient(to_right,black,transparent)] bg-gradient-to-r from-transparent via-blue-400/20 to-transparent animate-[shimmer_6s_linear_infinite]" />
        </div>
        
        {/* TITRE CENTRAL - Effet de respiration et Glitch doux */}
        <div className="absolute inset-0 flex flex-col items-center justify-center pointer-events-none select-none z-20">
          <div className="flex flex-col items-center animate-[breath_8s_ease-in-out_infinite]">
            
            <h1 className="relative text-7xl md:text-[10rem] font-[1000] tracking-tighter leading-tight text-white italic group">
              <span className="relative z-10 block drop-shadow-[0_10px_30px_rgba(0,0,0,0.8)]">SKYJO</span>
              
              {/* Reflet Shimmer balayant */}
              <span className="absolute inset-0 z-20 bg-gradient-to-r from-transparent via-white/30 to-transparent bg-[length:200%_100%] animate-[shimmer_5s_infinite] bg-clip-text text-transparent italic">
                SKYJO
              </span>

              {/* Lueur pulsée en fond */}
              <div className="absolute -inset-8 blur-[80px] bg-blue-600/20 opacity-40 animate-pulse" />
            </h1>
            
            {/* Sous-titre avec animation de scanline */}
            <div className="relative flex items-center gap-8 -mt-6">
              <div className="h-[1px] w-24 bg-gradient-to-l from-blue-400/40 to-transparent shadow-[0_0_8px_rgba(96,165,250,0.5)]" />
              <h2 className="text-sm md:text-xl font-medium tracking-[1.5em] text-blue-100/40 uppercase pl-6 transition-all duration-500 hover:text-blue-100/80">
                Edition <span className="text-white font-black tracking-[1em] drop-shadow-[0_0_10px_rgba(255,255,255,0.3)]">Réelle</span>
              </h2>
              <div className="h-[1px] w-24 bg-gradient-to-r from-blue-400/40 to-transparent shadow-[0_0_8px_rgba(96,165,250,0.5)]" />
            </div>
          </div>
        </div>

        {/* ACCENTS DÉCORATIFS VIVANTS */}
        <div className="absolute top-12 left-12 flex gap-4 opacity-30">
          <div className="w-1 h-8 bg-gradient-to-b from-blue-400 to-transparent rounded-full animate-pulse" />
          <Zap size={14} className="text-blue-400 mt-1 animate-bounce" />
        </div>

        <div className="absolute top-12 right-12 flex items-center gap-6 opacity-20 hover:opacity-60 transition-opacity duration-500">
           <Trophy size={18} className="text-white" />
           <div className="w-[1px] h-6 bg-white/20" />
           <Target size={18} className="text-white" />
        </div>
        
        <div className="absolute bottom-12 right-14 flex items-center gap-3 opacity-20">
           <Sparkles size={14} className="text-blue-300 animate-[spin_12s_linear_infinite]" />
           <span className="text-[8px] font-mono text-white tracking-[0.8em] uppercase">Engine_Active_0x242464</span>
        </div>

      </div>

      <style dangerouslySetInnerHTML={{ __html: `
        @keyframes shimmer {
          0% { background-position: -200% 0; }
          100% { background-position: 200% 0; }
        }
        @keyframes float {
          0%, 100% { transform: translateY(0) translateX(0) opacity: 0; }
          50% { transform: translateY(-50px) translateX(25px) opacity: 0.7; }
        }
        @keyframes breath {
          0%, 100% { transform: scale(1); filter: brightness(1); }
          50% { transform: scale(1.03); filter: brightness(1.1); }
        }
        @keyframes pulse {
          0%, 100% { transform: scale(1) translate(0, 0); opacity: 0.3; }
          50% { transform: scale(1.1) translate(20px, 10px); opacity: 0.5; }
        }
        body { margin: 0; background: #050510; overflow: hidden; -webkit-tap-highlight-color: transparent; }
      `}} />
    </div>
  );
};

export default App;