# Modèle de configuration : copiez ce fichier en .env et remplissez les valeurs.
# Ne mettez JAMAIS de vraies valeurs ici : ce fichier est versionné et le dépôt est public.
# Détail de chaque variable : docs/SERVEUR.md et docs/AUTHENTIFICATION.md.

# --- Base de données PostgreSQL ---
# En local : l'URL PUBLIQUE de la base Railway (l'URL interne ne marche que sur Railway).
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:port/base"
# Facultatif : utilisée si DATABASE_URL est absente.
DATABASE_PUBLIC_URL=""

# --- Administration (tableau de bord des retours) ---
# Mot de passe admin en clair, ou son empreinte SHA-256 (64 caractères hexadécimaux).
ADMIN_SECRET="changez-moi"
# Alternative prioritaire : empreinte SHA-256 du mot de passe admin.
# ADMIN_PASSWORD_HASH=""

# --- Notifications push (Web Push / VAPID) ---
# Générer une paire : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="cle-publique-vapid"
VAPID_PRIVATE_KEY="cle-privee-vapid"
VITE_VAPID_PUBLIC_KEY="cle-publique-vapid"

# --- Firebase côté navigateur (connexion Google) ---
# Valeurs de l'application web Firebase (console Firebase > Paramètres du projet).
# Elles sont publiques par nature (envoyées au navigateur), mais restez sur vos propres valeurs.
VITE_FIREBASE_API_KEY="..."
VITE_FIREBASE_AUTH_DOMAIN="votre-projet.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="votre-projet"
VITE_FIREBASE_STORAGE_BUCKET="votre-projet.appspot.com"
VITE_FIREBASE_SENDER_ID="..."
VITE_FIREBASE_APP_ID="..."
VITE_FIREBASE_MEASUREMENT_ID="..."

# --- Firebase côté serveur (vérification des jetons Google) ---
# Compte de service (console Firebase > Paramètres > Comptes de service > Générer une clé privée).
# SECRET : uniquement dans .env (local) et dans les variables Railway.
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@votre-projet.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Facultatif : sinon VITE_FIREBASE_PROJECT_ID est utilisée.
# FIREBASE_PROJECT_ID="votre-projet"
